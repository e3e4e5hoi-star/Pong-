      "roles": [
        {
          "description": "Your player needs a clearly readable pixel-art skin that functions as the left paddle and remains visually distinct during fast play.",
          "id": "player-paddle-pixel-skin",
          "label": "Selectable 2D pixel paddle/character skin"
        },
        {
          "description": "Your special 2D skin must use your attached image as its identity reference, preserve the depicted person’s recognizable face, and add a green metallic armored body without substituting a different face.",
          "id": "special-image-based-skin",
          "label": "Selectable image-based green-armored character skin"
        },
        {
          "description": "Your opponent needs a clear 2D paddle or character presentation that is easy to distinguish from your selected left-side skin.",
          "id": "computer-paddle",
          "label": "Computer-controlled right paddle"
        },
        {
          "description": "Your ball needs a compact, high-contrast 2D visual that remains easy to track against the court during rebounds and scoring exits.",
          "id": "pong-ball",
          "label": "Bouncing Pong ball"
        },
        {
          "description": "Your playfield needs an uncluttered modern 2D court treatment with visible top and bottom boundaries, a center division, and enough contrast for reliable gameplay.",
          "id": "court-playfield",
          "label": "Readable Pong court and boundaries"
        },
        {
          "description": "Your interface needs a readable Persian scoreboard for both scores and must display the title exactly as “Pong 22#$”, while fitting the modern 2D presentation.",
          "id": "persian-scoreboard",
          "label": "Persian scoreboard and game title treatment"
        },
        {
          "description": "Your Persian interface needs a clear way to preview and select between the 2D pixel skin and your supplied-image green-armored special skin.",
          "id": "skin-selection-ui",
          "label": "Skin selection interface"
        }
      ]
    },
