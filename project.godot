; Engine configuration file for Pong 22#$
config_version=5

[application]
config/name="Pong 22#$"
config/description="A Persian 2D Pong game with mouse and arrow-key controls, computer opponent, score tracking, collision detection and selectable skins."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/skins/user_green_armor.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027, 0.067, 0.122, 1)

[autoload]
TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
pause={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":4194305)
]
}

[editor]
import/use_multiple_threads=false
